# Backend API (fallback bila tidak pakai n8n webhook langsung)
VITE_API_BASE_URL=http://localhost:8085

# Nomor WhatsApp sekolah (format internasional tanpa +) — untuk link wa.me di chatbot
VITE_WHATSAPP_NUMBER=6281234567890

# n8n webhook — chatbot (Nexxa AI)
VITE_CHATBOT_WEBHOOK_URL=https://<host-n8n>/webhook/<path-chatbot>/chat

# n8n webhook — rekomendasi jurusan (Nexxa Match)
VITE_N8N_WEBHOOK_URL=https://<host-n8n>/webhook/<path-nexxa-match>

# Secret opsional untuk webhook n8n (isi bila workflow butuh header x-secret-key)
VITE_N8N_WEBHOOK_SECRET=
